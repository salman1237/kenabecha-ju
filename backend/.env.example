ENV=development
PROJECT_NAME="KenaBecha JU"

DATABASE_URL=postgresql+asyncpg://kenabecha:kenabecha@db:5432/kenabecha
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000"]
FRONTEND_URL=http://localhost:3000

MEDIA_ROOT=/app/media

# Google OAuth (Web application client ID, no secret needed for the ID-token flow)
GOOGLE_CLIENT_ID=

# SMTP — leave blank in dev to log emails to the console instead of sending them
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@kenabecha.ju
