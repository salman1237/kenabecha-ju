# env files
.env
.env.local
# Real production values live here, never committed. `.env` above does not
# match this — gitignore patterns are exact filenames, not prefixes — and the
# repo is public, so the omission would have published the secrets.
.env.prod
!*.env.example
!.env.prod.example

# backend
backend/__pycache__/
backend/**/__pycache__/
backend/.venv/
backend/.pytest_cache/
*.pyc

# frontend
frontend/node_modules/
frontend/.next/
frontend/out/

# OS
.DS_Store
Thumbs.db

# local tool config
.claude/settings.local.json
.claude/settings.json

# Python build metadata, regenerated by `pip install -e .`
*.egg-info/
__pycache__/
*.pyc

# Dokploy API key. Kept in a file rather than pasted into a chat or a command
# line, so it never lands in a transcript or shell history.
.dokploy.key
