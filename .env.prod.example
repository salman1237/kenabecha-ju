# Variables consumed by docker-compose.prod.yml — set these in Dokploy's environment UI.
POSTGRES_USER=kenabecha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kenabecha

JWT_SECRET_KEY=change-me

# JSON array of allowed frontend origins, e.g. ["https://kenabecha.example.com"]
CORS_ORIGINS=["https://your-domain.example.com"]

# Backend URL reachable from the browser (public), e.g. https://api.your-domain.example.com
NEXT_PUBLIC_API_URL=https://api.your-domain.example.com
