# Variables consumed by docker-compose.prod.yml — set these in Dokploy's environment UI.
#
# Hostnames. Both must have DNS A records pointing at the VPS before the
# first deploy, or Let's Encrypt cannot issue certificates for them.
# APP_DOMAIN serves the site; API_DOMAIN serves the API, which the browser
# calls directly for every request and for the chat WebSocket.
APP_DOMAIN=kenabechaju.deshlet.com
API_DOMAIN=api.kenabechaju.deshlet.com

POSTGRES_USER=kenabecha
POSTGRES_PASSWORD=change-me
POSTGRES_DB=kenabecha

JWT_SECRET_KEY=change-me

# JSON array of allowed frontend origins, e.g. ["https://kenabecha.example.com"]
CORS_ORIGINS=["https://kenabechaju.deshlet.com"]

# Backend URL reachable from the browser (public). Must match API_DOMAIN.
NEXT_PUBLIC_API_URL=https://api.kenabechaju.deshlet.com

# Public frontend URL — used to build links inside emails (password reset, notifications)
FRONTEND_URL=https://kenabechaju.deshlet.com

# Google OAuth (Web application client ID, no secret needed for the ID-token flow).
# Same value on both sides: GOOGLE_CLIENT_ID verifies tokens server-side,
# NEXT_PUBLIC_GOOGLE_CLIENT_ID is baked into the frontend build to render the button.
# Leave both blank to ship without Google sign-in.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# SMTP — leave SMTP_HOST blank to have the backend log emails instead of sending them
# (fine for staging, not for real users). Must support STARTTLS (port 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@deshlet.com

# Public origin of the site. Used for canonical URLs, Open Graph tags and
# sitemap.xml. Must match APP_DOMAIN.
NEXT_PUBLIC_SITE_URL=https://kenabechaju.deshlet.com

# How many days of nightly pg_dump files to keep in the db_backups volume.
BACKUP_KEEP_DAYS=7
